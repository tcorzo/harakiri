{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/out/**",
    "**/dist/**",
    "**/.tsbuild/**",
    "packages/jellyfin/src/generated/**",
    "**/.impeccable/**"
  ]
}
