# harakiri's mpv build. Every value is pinned. mpv/fetch.sh checks each sha256, and these URLs are
# the GPL source list a release links. Changing any file in mpv/ changes the recipe hash.
BASE_IMAGE=registry.fedoraproject.org/fedora:44@sha256:4f9a6c2f1eef83984ab0a2365fa99b3c080b0b028a02884c42f74ef8cb39e2fc
MPV_VERSION=0.42.0
MPV_URL=https://github.com/mpv-player/mpv/archive/refs/tags/v0.42.0.tar.gz
MPV_SHA256=bcfebbfa2b65a6d88dc97ea18117831072373e38b5785a2afb874ed4df5070dd
# GitLab's tag archive has no signature; the tag is commit 275f7dea27924cdd34ab2e6c20e448b6bc4fab65.
LIBPLACEBO_VERSION=7.387.0
LIBPLACEBO_URL=https://code.videolan.org/videolan/libplacebo/-/archive/v7.387.0/libplacebo-v7.387.0.tar.gz
LIBPLACEBO_SHA256=3bf5d72786682c194387c33d563872f6bfe202a9816f9dde6535a31a9b2e0d74
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
SDL2_VERSION=2.32.10
SDL2_URL=https://github.com/libsdl-org/SDL/releases/download/release-2.32.10/SDL2-2.32.10.tar.gz
SDL2_SHA256=5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165
NV_CODEC_HEADERS_VERSION=13.0.19.1
NV_CODEC_HEADERS_URL=https://github.com/FFmpeg/nv-codec-headers/releases/download/n13.0.19.1/nv-codec-headers-13.0.19.1.tar.gz
NV_CODEC_HEADERS_SHA256=eab9d02d461035a4baded23d4f2e2834e5b17934820b79cea45baaf0c85383eb
# curl-8.23.0.tar.xz.asc: good signature, key 27ED EAF2 2F3A BCEB 50DB 9A12 5CC9 08FD B71E 12C2.
# Fedora 44's libcurl 8.18.0 keeps a handle paused when it is added again (curl #20641), which
# stalls mpv's seeks; 8.19.0 fixed it.
CURL_VERSION=8.23.0
CURL_URL=https://curl.se/download/curl-8.23.0.tar.xz
CURL_SHA256=8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5
# shaderc and the three projects it builds from, linked statically into libplacebo with their
# symbols hidden: the host's Mesa drivers link their own libSPIRV-Tools.so (an unversioned soname
# with a C++ API), and a copy in the bundle would bind them to it. glslang, SPIRV-Tools and
# SPIRV-Headers are the commits shaderc v2026.4's DEPS file names, each a tagged release (its
# CHANGES: "Use Glslang 16.6.0, SPIRV-Tools v2026.4.rc2", the same commit as v2026.4). GitHub's
# tag archives are named <tag>.tar.gz, so each <NAME>_FILE names the local copy.
SHADERC_VERSION=2026.4
SHADERC_URL=https://github.com/google/shaderc/archive/refs/tags/v2026.4.tar.gz
SHADERC_FILE=shaderc-2026.4.tar.gz
SHADERC_SHA256=f06ce5bcca94e5df7f34e115743597d0ad2e13c5fe9213c67dc8c76031241947
GLSLANG_VERSION=16.6.0
GLSLANG_URL=https://github.com/KhronosGroup/glslang/archive/refs/tags/16.6.0.tar.gz
GLSLANG_FILE=glslang-16.6.0.tar.gz
GLSLANG_SHA256=9c09b901149c729df745057dafa815278aaa101b84d2b6e14f16a42de52f97f2
SPIRV_TOOLS_VERSION=2026.4
SPIRV_TOOLS_URL=https://github.com/KhronosGroup/SPIRV-Tools/archive/refs/tags/v2026.4.tar.gz
SPIRV_TOOLS_FILE=SPIRV-Tools-2026.4.tar.gz
SPIRV_TOOLS_SHA256=92df4c377603f086c3d2a1eb2bd9b8f883a73ca890fb939d78a0cecdcc01686c
SPIRV_HEADERS_VERSION=1.202609.0
SPIRV_HEADERS_URL=https://github.com/KhronosGroup/SPIRV-Headers/archive/refs/tags/v1.202609.0.tar.gz
SPIRV_HEADERS_FILE=SPIRV-Headers-1.202609.0.tar.gz
SPIRV_HEADERS_SHA256=0bac674ba1fd0a0d969b9c539a58322d37cb890a8af13b71177a64534c03b473
