amends "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl"

local typecheck = new Step {
  glob = List("**/*.ts", "**/*.tsx", "**/tsconfig*.json")
  check = "scripts/bounded.sh typecheck 4G -- bun x tsc -b"
}

local test = new Step {
  glob = List("**/*.ts", "**/*.tsx")
  check = "scripts/bounded.sh test 3G -- bun x vitest run --maxWorkers=2"
}

steps {
  // A commit that stages only ignored files (the generated Jellyfin client, routeTree.gen.ts) hands
  // oxlint and oxfmt nothing to check; that is a pass, not an error.
  ["oxlint"] {
    glob = List("**/*.ts", "**/*.tsx")
    check = "bun x oxlint --type-aware --no-error-on-unmatched-pattern {{files}}"
    fix = "bun x oxlint --type-aware --no-error-on-unmatched-pattern --fix {{files}}"
  }
  ["oxfmt"] {
    glob = List("**/*.ts", "**/*.tsx", "**/*.json", "**/*.md", "**/*.css")
    check = "bun x oxfmt --check --no-error-on-unmatched-pattern {{files}}"
    fix = "bun x oxfmt --no-error-on-unmatched-pattern {{files}}"
  }
  // A test that can skip belongs in a live, contract or FATE tier (vitest.shared.ts).
  ["lint-skips"] {
    glob = List("**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx")
    check = "bun scripts/lint-skips.ts {{files}}"
  }
  // The repo is public: no workstation paths, owner domains or library titles (.private-denylist).
  ["lint-private"] {
    glob = List("**/*")
    check = "bun scripts/lint-private.ts {{files}}"
  }
  // Features ask host capabilities; only apps/desktop/src/main/host names a platform.
  ["lint-host"] {
    glob = List("**/*.ts", "**/*.tsx")
    check = "bun scripts/lint-host.ts {{files}}"
  }
  ["typecheck"] = (typecheck) { profiles = List("ci") }
  ["test"] = (test) { profiles = List("ci") }
}

hooks {
  ["pre-push"] {
    steps {
      ["typecheck"] = typecheck
      ["test"] = test
    }
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}
