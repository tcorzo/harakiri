# Jellyfin server used by the app in development
VITE_JELLYFIN_URL=http://localhost:8096

# Dev Jellyfin library (dev/jellyfin/COMMANDS.txt). Default: the generated corpus in .cache/corpus.
# To use your own library instead, uncomment and set real paths:
# JELLYFIN_DEV_LIBRARY=own
# JELLYFIN_DEV_MOVIES=/path/to/your/movies
# JELLYFIN_DEV_SERIES=/path/to/your/series
# Image mirror (keep the digest): JELLYFIN_IMAGE=registry.example/jellyfin/jellyfin:12.4@sha256:7da5184caa38c553f219f6772476540081f392a68049e2b68c923f6daf877f8e
# FATE samples mirror: HARAKIRI_FATE_MIRROR=https://mirror.example/fate-suite
